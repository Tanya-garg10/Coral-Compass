# Pick one provider. The app auto-detects which key is set.
# All three use the OpenAI chat-completions schema.

# Cerebras Cloud (free tier, fast inference)
# Get a key: https://cloud.cerebras.ai/platform/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenAI (paid)
# OPENAI_API_KEY=sk-...

# OpenRouter (free tier on some models)
# OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides (rarely needed):
# AI_BASE_URL=https://api.cerebras.ai/v1
# AI_MODEL=gpt-oss-120b
